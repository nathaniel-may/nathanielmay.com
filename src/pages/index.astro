---
import Layout from '~/layouts/Layout.astro';
import SlantedNav from '~/components/ui/SlantedNav.astro';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import inversionzUrl from '~/assets/fonts/Inversionz.otf?url';

const metadata = {
  title: 'Nathaniel May — Engineering Manager',
  ignoreTitleTemplate: true,
};

const nameFontFaceCss = `@font-face { font-family: 'Inversionz'; src: url('${inversionzUrl}') format('opentype'); font-display: swap; }`;
---

<Layout metadata={metadata}>
  <style set:html={nameFontFaceCss} />

  <main class="min-h-screen flex items-center justify-center gap-12 md:gap-24 px-6">
    <div
      class="text-5xl md:text-9xl font-bold tracking-[-0.2em]"
      style="writing-mode: vertical-rl; text-orientation: upright; font-family: 'Inversionz';"
    >
      NATHANIEL
    </div>

    <div class="flex flex-col items-center gap-8">
      <div
        class="text-5xl md:text-9xl font-bold tracking-[-0.2em]"
        style="writing-mode: vertical-rl; text-orientation: upright; font-family: 'Inversionz';"
      >
        MAY
      </div>

      <SlantedNav
        links={[
          { text: 'Posts', href: getBlogPermalink() },
          { text: 'Projects', href: getPermalink('/projects') },
          { text: 'Career', href: '/resume.pdf' },
        ]}
      />
    </div>
  </main>
</Layout>
