---
import Layout from '~/layouts/Layout.astro';
import Button from '~/components/ui/Button.astro';
import FontSwitcher from '~/components/ui/FontSwitcher.astro';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Nathaniel May — Engineering Manager',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen flex items-center justify-center gap-12 md:gap-24 px-6">
    <div
      class="font-target text-5xl md:text-9xl font-bold tracking-[-0.2em]"
      style="writing-mode: vertical-rl; text-orientation: upright;"
    >
      NATHANIEL
    </div>

    <div class="flex flex-col items-center gap-8">
      <div
        class="font-target text-5xl md:text-9xl font-bold tracking-[-0.2em]"
        style="writing-mode: vertical-rl; text-orientation: upright;"
      >
        MAY
      </div>

      <div class="flex flex-col gap-4 w-40">
        <Button variant="primary" text="Posts" href={getBlogPermalink()} />
        <Button variant="primary" text="Projects" href={getPermalink('/projects')} />
        <Button variant="primary" text="Career" href="/resume.pdf" />
      </div>
    </div>
  </main>

  <FontSwitcher />
</Layout>
