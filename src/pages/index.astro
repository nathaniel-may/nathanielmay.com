---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Nathaniel May — Engineering Manager',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        text: 'LinkedIn',
        href: 'https://www.linkedin.com/in/nathanieldmay/',
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
      {
        variant: 'primary',
        text: 'GitHub',
        href: 'https://github.com/nathaniel-may',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
      {
        text: 'Posts',
        href: getBlogPermalink(),
        icon: 'tabler:article',
      },
      {
        text: 'Projects',
        href: getPermalink('/projects'),
        icon: 'tabler:apps',
      },
    ]}
  >
    <Fragment slot="title">
      Nathaniel May
    </Fragment>

    <Fragment slot="subtitle">
      <span class="block text-xl mb-2">Engineering Manager</span>
      <span class="block text-lg mb-4 text-muted">
        Hiring Pipelines · Coaching · Distributed Systems · Data Analytics
      </span>
      <span class="block text-base text-default">
        Nathaniel May is an Engineering Manager focused on hiring pipelines, coaching, distributed systems, and data
        analytics. He builds teams and infrastructure that scale.
      </span>
    </Fragment>

    <Fragment slot="bg">
      <Image
        src="~/assets/images/bg.jpg"
        class="absolute inset-0 w-full h-full object-cover"
        widths={[400, 768, 1024, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        alt=""
      />
      <div class="absolute inset-0 bg-white/55 dark:bg-black/30"></div>
    </Fragment>
  </Hero>
</Layout>
