---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import SlantedNav from '~/components/ui/SlantedNav.astro';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { footerData } from '~/navigation';
import inversionzUrl from '~/assets/fonts/Inversionz.otf?url';

const linkedin = footerData.socialLinks.find((link) => link.ariaLabel === 'LinkedIn');
const github = footerData.socialLinks.find((link) => link.ariaLabel === 'GitHub');

const COLOR_BG = '#E2DABF';
const COLOR_FG = '#1c1a18';

// ---------------------------------------------------------------------
// Font-specific tuning for the vertical NATHANIEL/MAY text. None of
// these values are guaranteed to carry over to a different font — if
// you swap NAME_FONT_FAMILY, re-verify all of them:
//
// - NAME_TRACKING and the text-9xl font-size class on the name divs
//   below both affect MAY's rendered width, which NAV_WIDTH is derived
//   from (see its own comment). Re-measure MAY's width after any
//   change here and adjust NAV_WIDTH to match.
// - NAME_TEXT_BOX_EDGE controls how much text-box-trim removes from
//   the vertical line's width. 'cap'/'alphabetic' clipped the glyph
//   outright for Inversionz; 'text' was the one keyword (out of every
//   valid over/under combination, swept programmatically) that landed
//   exactly on the ink width with zero clipping. A different font may
//   need a different keyword — verify by comparing the trimmed width
//   against Range.getBoundingClientRect() on the text node.
//
// NOT in this list: the top-of-glyph trim in the <script> below. It
// measures the live rendered font via canvas at runtime, so it
// self-adjusts for any font/text/size automatically — nothing to
// retune there.
// ---------------------------------------------------------------------
const NAME_FONT_FAMILY = 'Inversionz';
const NAME_TRACKING = '-0.2em';
const NAME_TEXT_BOX_EDGE = 'text';
const nameStyle = `writing-mode: vertical-rl; text-orientation: upright; font-family: '${NAME_FONT_FAMILY}'; letter-spacing: ${NAME_TRACKING}; text-box: trim-both ${NAME_TEXT_BOX_EDGE}; color: ${COLOR_FG};`;

// Width of the MAY/logos/nav column. Must be at least MAY's rendered
// width (governed by the font tuning above) + the icon column's width
// (32px) + a gap between them, or the icons overflow past the row's
// right edge.
const NAV_WIDTH = 176;

const metadata = {
  title: 'Nathaniel May — Engineering Manager',
  ignoreTitleTemplate: true,
};

const nameFontFaceCss = `@font-face { font-family: '${NAME_FONT_FAMILY}'; src: url('${inversionzUrl}') format('opentype'); font-display: swap; }`;
---

<Layout metadata={metadata}>
  <style set:html={nameFontFaceCss}></style>

  <main class="min-h-screen flex items-center justify-center px-6" style={`background-color: ${COLOR_BG};`}>
    <div class="flex flex-row items-stretch gap-12">
      <div class="vertical-name-wrap inline-block overflow-hidden">
        <div
          class="vertical-name font-bold text-9xl"
          style={nameStyle}
        >
          NATHANIEL
        </div>
      </div>

      <div class="flex flex-col justify-between" style={`width: ${NAV_WIDTH}px;`}>
        <div class="flex flex-row items-start justify-between">
          <div class="vertical-name-wrap inline-block overflow-hidden">
            <div
              class="vertical-name font-bold text-9xl"
              style={nameStyle}
            >
              MAY
            </div>
          </div>

          <div class="flex flex-col gap-3">
            {
              linkedin && (
                <a href={linkedin.href} target="_blank" rel="noopener noreferrer" aria-label={linkedin.ariaLabel}>
                  <Icon name={linkedin.icon} class="h-8 w-8" style={`color: ${COLOR_FG};`} />
                </a>
              )
            }
            {
              github && (
                <a href={github.href} target="_blank" rel="noopener noreferrer" aria-label={github.ariaLabel}>
                  <Icon name={github.icon} class="h-8 w-8" style={`color: ${COLOR_FG};`} />
                </a>
              )
            }
          </div>
        </div>

        <SlantedNav
          width={NAV_WIDTH}
          fill={COLOR_FG}
          strokeColor={COLOR_FG}
          textColor={COLOR_BG}
          links={[
            { text: 'Posts', href: getBlogPermalink() },
            { text: 'Projects', href: getPermalink('/projects') },
            // TODO: point at a real career/resume destination once one
            // exists without personal contact info baked into a public PDF.
            { text: 'Career', href: '#' },
          ]}
        />
      </div>
    </div>
  </main>

  <script>
    // The block-axis (left/right, in vertical-rl) width was matched to
    // the font's "text" metric box via text-box-trim, but that doesn't
    // mean the ink sits flush against the left edge within that width —
    // text-orientation:upright doesn't simply left-align it. Pixel-
    // measured a real ~16px gap on the left for this font (the right
    // side has its own, separate gap this doesn't touch).
    //
    // Canvas TextMetrics predicts the top gap via
    // advance-width - actualBoundingBoxRight (see below), and separately
    // predicts this left gap via 2 * fontBoundingBoxDescent — matched
    // exactly (16px predicted, 16px pixel-measured) for this font, so
    // derive it from the real font rather than hand-picking a value.
    async function trimVerticalNameGaps() {
      await document.fonts.ready;

      document.querySelectorAll<HTMLElement>('.vertical-name-wrap').forEach((wrap) => {
        const inner = wrap.firstElementChild as HTMLElement | null;
        if (!inner) return;
        const text = inner.textContent?.trim();
        if (!text) return;

        const cs = getComputedStyle(inner);
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        const metrics = ctx.measureText(text[0]);
        const topGap = metrics.width - metrics.actualBoundingBoxRight;
        const leftGap = 2 * metrics.fontBoundingBoxDescent;

        if (topGap > 0) {
          const naturalHeight = inner.getBoundingClientRect().height;
          wrap.style.height = `${naturalHeight - topGap}px`;
          inner.style.marginTop = `${-topGap}px`;
        }

        if (leftGap > 0) {
          const naturalWidth = inner.getBoundingClientRect().width;
          wrap.style.width = `${naturalWidth - leftGap}px`;
          inner.style.marginLeft = `${-leftGap}px`;
        }
      });
    }
    trimVerticalNameGaps();
  </script>
</Layout>
