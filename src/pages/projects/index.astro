---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Section from '~/components/ui/Section.astro';
import { projects } from '~/data/projects';

const metadata = {
  title: 'Projects',
};

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Layout metadata={metadata}>
  <Section>
    <h1 class="display text-4xl mb-4">Projects</h1>
    <p class="text-lg text-muted mb-10">Tools and projects I actively maintain.</p>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        projects.map(({ title, description, href, image, imageAlt, since }) => (
          <a
            class="group flex flex-col overflow-hidden rounded-2xl border border-gray-500/20 bg-surface/40 transition-colors duration-200 hover:border-primary/50 hover:bg-surface/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={image}
              alt={imageAlt}
              widths={[400, 800]}
              sizes="(min-width: 640px) 416px, calc(100vw - 48px)"
              format="webp"
              layout="responsive"
              class="border-b border-gray-500/20"
            />
            <div class="flex flex-1 flex-col p-7">
              <h2 class="heading mb-2 text-2xl">{title}</h2>
              <p class="mb-6 text-muted">{description}</p>
              <span class="mt-auto inline-flex items-center font-medium text-primary">
                Visit project
                <Icon
                  name="tabler:arrow-up-right"
                  class="ml-1 h-5 w-5 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
              <p class="mt-4 border-t border-gray-500/20 pt-4 text-sm text-muted">
                Since {dateFormatter.format(since)}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </Section>
</Layout>
