---
/**
 * The stack figure for "Herding Agents". One source, rendered once per section
 * with a different `highlight`, so geometry, palette and copy live in exactly
 * one place and every appearance follows an edit here.
 *
 * Two assets, not one drawing that reflows. The wide layout is landscape and
 * the narrow one is portrait, and no amount of CSS turns one into the other:
 * the hub is a horizontal bar above two side-by-side devices in the first and a
 * vertical bar beside two stacked devices in the second. Which one renders is a
 * container query on the wrapper rather than a media query, because the figure
 * breaks out of the reading measure and the viewport is only a proxy for the
 * room it actually gets — a scrollbar, browser zoom and device pixel ratio all
 * pull the two apart. Both carry the same `data-key` set, so a group added to
 * one and forgotten in the other is a visible bug.
 *
 * The narrow layout drops two things the wide one says, on purpose. herdr and
 * Zed stack instead of sitting side by side, which loses the left/right swipe
 * the desktop composition mirrors; and the devices stack too. Legibility won:
 * at phone width, preserving either arrangement costs the sandbox labels more
 * room than they have.
 *
 * Palette and the two rules behind it are borrowed from ArchDiagram.astro so
 * the two figures read as one system: amber is reserved for the lit state, and
 * exactly one object carries a hue at rest. Here that object is the GitHub bar,
 * which is also the one group that never dims — it is true at every step of the
 * walk, so it holds its teal while the rest recedes. It never goes amber; amber
 * marks the layer a section is actually about.
 *
 * Arrowheads are drawn as paths rather than <marker> elements on purpose.
 * Markers are referenced by document-global id, and this component renders many
 * times on one page — every `url(#id)` would resolve to the first instance's
 * definition, which is invisible until one instance differs and then very
 * confusing. Paths have no such coupling.
 *
 * Groups are siblings rather than nested so any combination lights
 * independently: asking for `sandbox` must not drag `herdr` along. Each path to
 * the hub travels inside the group it leaves from, so lighting a layer also
 * lights its route out.
 *
 * Dark-only, matching the site.
 */
interface Props {
  /** One or more of: macbook, herdr, sandbox, cross-review, zed, phone. */
  highlight?: string | string[];
  /** Overrides the generated aria-label when a section needs a specific one. */
  label?: string;
}

const { highlight = [], label } = Astro.props;
const keys = (Array.isArray(highlight) ? highlight : [highlight]).filter(Boolean);
const lit = new Set(keys);
const grp = (k: string) => (lit.has(k) ? 'grp lit' : 'grp');

const aria =
  label ??
  (keys.length
    ? `Stack diagram, highlighting ${keys.join(' and ')}: GitHub, a phone and a MacBook.`
    : 'Stack diagram: GitHub, a phone and a MacBook.');
---

<div class="stack-fig breakout-narrow not-prose" role="img" aria-label={aria}>
  {/* ============ wide: hub above two side-by-side devices ============ */}
  <svg class:list={['stack', 'stack-wide', keys.length && 'engaged']} viewBox="0 0 900 540" aria-hidden="true">
    <g class={grp('macbook')} data-key="macbook">
      <rect class="shell-rect" x="250" y="160" width="610" height="346" rx="10"></rect>
      <text class="n-title" x="270" y="188">MacBook</text>
    </g>

    <g class={grp('herdr')} data-key="herdr">
      <rect class="panel-rect" x="270" y="206" width="440" height="280" rx="8"></rect>
      <text class="n-title" x="288" y="232">herdr</text>
      <path class="edge" d="M620,206 L620,97"></path>
      <path class="arrow" d="M616,97 L620,90 L624,97 Z"></path>
      <rect class="ghost-rect" x="340" y="444" width="300" height="20" rx="4"></rect>
      <text class="n-tag" x="490" y="458" text-anchor="middle">…</text>
    </g>

    <g class={grp('sandbox')} data-key="sandbox">
      <rect class="node-rect" x="340" y="252" width="300" height="56" rx="6"></rect>
      <text class="n-tag" x="354" y="285">sbx /dev-workflow</text>
      <rect class="chip-rect" x="520" y="268" width="104" height="24" rx="4"></rect>
      <text class="n-chip" x="572" y="284" text-anchor="middle">Claude Code</text>
    </g>

    <g class={grp('cross-review')} data-key="cross-review">
      <path class="edge" d="M490,308 L490,349"></path>
      <path class="arrow" d="M486,349 L490,356 L494,349 Z"></path>
      <rect class="node-rect" x="340" y="360" width="300" height="56" rx="6"></rect>
      <text class="n-tag" x="354" y="393">sbx /pr-review</text>
      <rect class="chip-rect" x="520" y="376" width="104" height="24" rx="4"></rect>
      <text class="n-chip" x="572" y="392" text-anchor="middle">Codex</text>
    </g>

    <g class={grp('zed')} data-key="zed">
      <rect class="panel-rect" x="728" y="206" width="116" height="280" rx="8"></rect>
      <text class="n-title" x="786" y="351" text-anchor="middle">Zed</text>
      <path class="edge" d="M786,206 L786,97"></path>
      <path class="arrow" d="M782,97 L786,90 L790,97 Z"></path>
    </g>

    <g class={grp('phone')} data-key="phone">
      <rect class="shell-rect" x="40" y="160" width="160" height="346" rx="10"></rect>
      <text class="n-title" x="58" y="188">Phone</text>
      <rect class="node-rect" x="56" y="262" width="128" height="56" rx="6"></rect>
      <text class="n-chip" x="120" y="295" text-anchor="middle">GitHub app</text>
      <rect class="node-rect" x="56" y="378" width="128" height="56" rx="6"></rect>
      <text class="n-chip" x="120" y="411" text-anchor="middle">Termux</text>
      <path class="edge" d="M120,262 L120,97"></path>
      <path class="arrow" d="M116,97 L120,90 L124,97 Z"></path>
      <path class="edge" d="M184,406 L257,406"></path>
      <path class="arrow" d="M257,402 L264,406 L257,410 Z"></path>
      <rect class="pill-rect" x="203" y="395" width="34" height="20" rx="10"></rect>
      <text class="n-tag" x="220" y="409" text-anchor="middle">ssh</text>
    </g>

    <g class="grp anchor" data-key="hub">
      <rect class="core-rect" x="40" y="24" width="820" height="56" rx="8"></rect>
      <text class="n-hub" x="450" y="58" text-anchor="middle">GitHub</text>
    </g>
  </svg>

  {/* ============ narrow: hub beside two stacked devices ============ */}
  <svg class:list={['stack', 'stack-narrow', keys.length && 'engaged']} viewBox="0 0 380 663" aria-hidden="true">
    <g class={grp('macbook')} data-key="macbook">
      <rect class="shell-rect" x="14" y="173" width="286" height="470" rx="10"></rect>
      <text class="n-title" x="28" y="197">MacBook</text>
    </g>

    <g class={grp('herdr')} data-key="herdr">
      <rect class="panel-rect" x="28" y="211" width="258" height="290" rx="8"></rect>
      <text class="n-title" x="42" y="234">herdr</text>
      <path class="edge" d="M286,280 L313,280"></path>
      <path class="arrow" d="M313,276 L320,280 L313,284 Z"></path>
      <rect class="ghost-rect" x="42" y="459" width="230" height="18" rx="4"></rect>
      <text class="n-tag" x="157" y="472" text-anchor="middle">…</text>
    </g>

    <g class={grp('sandbox')} data-key="sandbox">
      <rect class="node-rect" x="42" y="248" width="230" height="72" rx="6"></rect>
      <text class="n-tag" x="54" y="270">sbx /dev-workflow</text>
      <rect class="chip-rect" x="54" y="280" width="104" height="24" rx="4"></rect>
      <text class="n-chip" x="106" y="296" text-anchor="middle">Claude Code</text>
    </g>

    <g class={grp('cross-review')} data-key="cross-review">
      <path class="edge" d="M157,320 L157,357"></path>
      <path class="arrow" d="M153,357 L157,364 L161,357 Z"></path>
      <rect class="node-rect" x="42" y="365" width="230" height="72" rx="6"></rect>
      <text class="n-tag" x="54" y="387">sbx /pr-review</text>
      <rect class="chip-rect" x="54" y="397" width="104" height="24" rx="4"></rect>
      <text class="n-chip" x="106" y="413" text-anchor="middle">Codex</text>
    </g>

    <g class={grp('zed')} data-key="zed">
      <rect class="panel-rect" x="28" y="519" width="258" height="96" rx="8"></rect>
      <text class="n-title" x="157" y="572" text-anchor="middle">Zed</text>
      <path class="edge" d="M286,567 L313,567"></path>
      <path class="arrow" d="M313,563 L320,567 L313,571 Z"></path>
    </g>

    <g class={grp('phone')} data-key="phone">
      <rect class="shell-rect" x="14" y="20" width="286" height="112" rx="10"></rect>
      <text class="n-title" x="28" y="44">Phone</text>
      <rect class="node-rect" x="28" y="58" width="122" height="46" rx="6"></rect>
      <text class="n-chip" x="89" y="86" text-anchor="middle">Termux</text>
      <rect class="node-rect" x="164" y="58" width="122" height="46" rx="6"></rect>
      <text class="n-chip" x="225" y="86" text-anchor="middle">GitHub app</text>
      <path class="edge" d="M286,81 L313,81"></path>
      <path class="arrow" d="M313,77 L320,81 L313,85 Z"></path>
      <path class="edge" d="M89,132 L89,166"></path>
      <path class="arrow" d="M85,166 L89,173 L93,166 Z"></path>
      <rect class="pill-rect" x="98" y="140" width="34" height="20" rx="10"></rect>
      <text class="n-tag" x="115" y="154" text-anchor="middle">ssh</text>
    </g>

    <g class="grp anchor" data-key="hub">
      <rect class="core-rect" x="320" y="20" width="44" height="623" rx="8"></rect>
      <text class="n-hub" x="342" y="331" text-anchor="middle" transform="rotate(90 342 331)">GitHub</text>
    </g>
  </svg>
</div>

<style>
  .stack-fig {
    /* The swap keys off this element's width, not the viewport's: the figure
       breaks out of the reading measure, and zoom and device pixel ratio move
       the two numbers apart. Asking the container removes the mismatch. */
    container-type: inline-size;

    --ink: #080b0d;
    --shell: #111a21;
    --panel: #0a0f12;
    --core: #0d2028;
    --core-edge: #4d7d8b;
    --node: #202d37;
    --line: #2b3a45;
    --line-soft: #1a242b;
    --edge: #3a4a54;
    --text: #dce4e7;
    --muted: #7e8f9a;
    --dim: #55646d;
    --amber: #e5a44e;

    background: var(--ink);
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    padding: 20px;
    margin-block: 2rem;
  }

  .stack {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 860px is the wide layout's legibility floor: its smallest type is 11px in a
     900-unit viewBox, so below this it renders under ~10.5px. */
  .stack-narrow {
    display: none;
  }
  @container (max-width: 860px) {
    .stack-wide {
      display: none;
    }
    .stack-narrow {
      display: block;
      max-width: 420px;
      margin-inline: auto;
    }
  }

  /* Value descends inward: shells are the lit surface, panels are holes cut in
     them, nodes sit back up. */
  .shell-rect {
    fill: var(--shell);
    stroke: var(--line);
  }
  .panel-rect {
    fill: var(--panel);
    stroke: #35474f;
  }
  .node-rect {
    fill: var(--node);
    stroke: var(--line);
  }
  .chip-rect {
    fill: #16212a;
    stroke: var(--line);
  }
  .ghost-rect {
    fill: none;
    stroke: var(--line-soft);
    stroke-dasharray: 4 4;
  }
  .pill-rect {
    fill: var(--shell);
    stroke: var(--line);
  }
  .core-rect {
    fill: var(--core);
    stroke: var(--core-edge);
    filter: drop-shadow(0 0 16px rgb(77 125 139 / 0.22));
  }

  .n-title {
    fill: var(--text);
    font: 600 13px var(--font-sans, ui-sans-serif), system-ui, sans-serif;
  }
  .n-hub {
    fill: var(--text);
    font: 600 15px var(--font-sans, ui-sans-serif), system-ui, sans-serif;
  }
  .n-chip {
    fill: var(--muted);
    font: 400 11px var(--font-sans, ui-sans-serif), system-ui, sans-serif;
  }
  .n-tag {
    fill: var(--dim);
    font: 400 11px var(--font-sans, ui-sans-serif), system-ui, sans-serif;
  }

  .edge {
    fill: none;
    stroke: var(--edge);
    stroke-width: 1.5;
  }
  .arrow {
    fill: var(--edge);
  }

  /* Everything unlit recedes; the anchor and the lit layer do not. */
  .stack.engaged .grp {
    opacity: 0.26;
  }
  .stack.engaged .grp.anchor,
  .stack.engaged .grp.lit {
    opacity: 1;
  }

  .grp.lit .shell-rect,
  .grp.lit .panel-rect,
  .grp.lit .node-rect {
    stroke: var(--amber);
    filter: drop-shadow(0 0 12px rgb(229 164 78 / 0.28));
  }
  .grp.lit .node-rect {
    fill: #1e2932;
  }
  .grp.lit .n-title {
    fill: #fff;
  }
  .grp.lit .n-chip,
  .grp.lit .n-tag {
    fill: var(--text);
  }
  .grp.lit .edge {
    stroke: var(--amber);
  }
  .grp.lit .arrow {
    fill: var(--amber);
  }
</style>
