---
/**
 * A figure for post bodies: one or more images, an optional side-by-side row
 * beneath them, and a caption that can carry a source credit.
 *
 * `not-prose` is load-bearing — post bodies are `prose`, and Tailwind
 * Typography would otherwise restyle the images and the caption. `breakout`
 * opts the figure out of the reading measure so screenshots get the full
 * container width; text around it stays at the reading measure.
 *
 * Images are styled through `:global()` because slot children render in the
 * *parent's* scope rather than this component's, so a plain descendant
 * selector here would never match them.
 */
interface Props {
  /** Sentence describing the figure. Rendered before the credit. */
  caption?: string;
  /** Source attribution, e.g. a site name. */
  credit?: string;
  /** Makes the credit a link. */
  creditHref?: string;
}

const { caption, credit, creditHref } = Astro.props;
const hasRow = Astro.slots.has('row');
---

<figure class="fig breakout not-prose">
  <slot />
  {
    hasRow && (
      <div class="fig-row">
        <slot name="row" />
      </div>
    )
  }
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {caption && credit && ' '}
        {credit && (
          <span class="fig-credit">
            Source: {creditHref ? <a href={creditHref}>{credit}</a> : credit}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .fig {
    margin-block: 2rem;
  }

  .fig :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The row is phone screenshots: tall, so it gets a narrower ceiling than the
     breakout width, or a pair of them would run past a screen height. */
  .fig-row {
    display: flex;
    gap: 1rem;
    max-width: 600px;
    margin: 1rem auto 0;
  }

  .fig-row > :global(*) {
    flex: 1 1 0;
    min-width: 0;
  }

  /* Rectangular screenshots get their corners from CSS. The desktop shot
     carries its own rounded corners in the alpha channel and is left alone. */
  .fig-row :global(img) {
    border-radius: 0.75rem;
  }

  figcaption {
    margin-top: 0.875rem;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-foreground-subtle);
  }

  .fig-credit a {
    color: var(--color-primary);
  }

  @media (max-width: 480px) {
    .fig-row {
      flex-direction: column;
    }
  }
</style>
