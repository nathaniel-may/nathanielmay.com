---
export interface NavLink {
  text: string;
  href: string;
}

export interface Props {
  links: NavLink[];
  angle?: number;
  width?: number;
  thickness?: number;
  borderWidth?: number;
  gap?: number;
  popDistance?: number;
  fill?: string;
  strokeColor?: string;
  textColor?: string;
  class?: string;
}

const {
  links,
  angle = 30,
  width = 150,
  thickness = 72,
  borderWidth = 5,
  gap = -80,
  popDistance = 18,
  fill = '#ffffff',
  strokeColor = '#000000',
  textColor = '#000000',
  class: className = '',
} = Astro.props;

// Each plank keeps vertical left/right edges (so stacked items' edges line up
// into one straight vertical line) and only slants the top/bottom edges by
// `angle` degrees, which is what makes the shape an actual parallelogram
// instead of a rotated rectangle's pointed silhouette.
const angleRad = (angle * Math.PI) / 180;
const rise = width * Math.tan(angleRad);
const totalHeight = thickness + rise;
const points = `0,${rise} ${width},0 ${width},${thickness} 0,${totalHeight}`;
const clipPath = `polygon(0px ${rise}px, ${width}px 0px, ${width}px ${thickness}px, 0px ${totalHeight}px)`;

const popX = popDistance * Math.cos(angleRad);
const popY = -popDistance * Math.sin(angleRad);

// Each plank's white fill only reaches into two opposite corners of its own
// bounding box (a diagonal sliver at the top-right and another at the
// bottom-left) — the rest of those corners are transparent. That means
// bounding boxes can overlap (negative gap) well before the actual white
// shapes touch. They meet exactly at gap = -rise; past that the fills
// intersect, so warn if the requested gap pushes beyond it.
const maxOverlap = rise;
if (gap < -maxOverlap) {
  console.warn(
    `[SlantedNav] gap=${gap} exceeds the safe overlap limit of -${maxOverlap.toFixed(1)} for angle=${angle}/width=${width} — plank shapes will visually intersect.`
  );
}
---

<div class={`slanted-nav flex flex-col items-center ${className}`}>
  {
    links.map((link, i) => (
      <a
        href={link.href}
        class="plank relative block transition-transform duration-200"
        style={`width: ${width}px; height: ${totalHeight}px; margin-top: ${i === 0 ? 0 : gap}px; clip-path: ${clipPath}; --pop-x: ${popX}px; --pop-y: ${popY}px;`}
      >
        <svg
          viewBox={`0 0 ${width} ${totalHeight}`}
          width={width}
          height={totalHeight}
          class="absolute inset-0 block"
          preserveAspectRatio="none"
        >
          <polygon
            points={points}
            fill={fill}
            stroke={strokeColor}
            stroke-width={borderWidth}
            stroke-linejoin="round"
          />
        </svg>
        <span
          class="absolute left-1/2 top-1/2 whitespace-nowrap text-2xl font-extrabold"
          style={`transform: translate(-50%, -50%) rotate(${-angle}deg); color: ${textColor};`}
        >
          {link.text}
        </span>
      </a>
    ))
  }
</div>

<style>
  .plank {
    z-index: 1;
  }
  .plank:hover {
    transform: translate(var(--pop-x), var(--pop-y));
    z-index: 10;
  }
</style>
