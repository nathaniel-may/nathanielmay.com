---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

// The body is a wide container whose children sit at the reading measure, so
// text renders identically to a narrow one and elements marked `breakout` — in
// practice, one figure — can span the full width. The header is unaffected, so
// the title still lines up with the body.
//
// Unconditional rather than opt-in: gating this on frontmatter made a figure's
// width depend on a flag five files away, and every link in that chain failed
// silently and identically, by handing the figure the reading measure.
// `prose` would otherwise override the measure's max-width; see AGENTS.md.
---

{
  /* `w-full` because `mx-auto` on a flex child disables cross-axis stretch, which
    would otherwise shrink-wrap this section to its widest content and leave a
    wide post's container narrower than its own max-width. */
}
<section class="py-8 sm:py-16 lg:py-20 mx-auto w-full">
  <article>
    <header class="intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade">
      <div class="measure mb-2 flex flex-col justify-between sm:flex-row sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 text-foreground-subtle" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 text-foreground-subtle" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      <h1 class="measure heading text-4xl md:text-5xl">{post.title}</h1>
      <p class="measure mt-4 mb-8 text-xl md:text-2xl text-muted text-justify">
        {post.excerpt}
      </p>

      {
        post.image ? (
          /* Image and credit share a <figure> so nothing can be rendered between
             them. They were previously two siblings either side of the body
             boundary, which put the post-wide disclaimer in the gap. */
          <figure class="mb-6">
            <Image
              src={post.image}
              class="max-w-full lg:max-w-225 mx-auto sm:rounded-md bg-surface"
              widths={[400, 900]}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.imageAlt ?? ''}
              width={900}
              height={506}
              format="webp"
              loading="eager"
              decoding="async"
            />
            {post.imageCredit && (
              <figcaption
                class="text-foreground-subtle [&_a]:text-primary mx-auto mt-3 max-w-225 px-6 text-sm italic"
                set:html={post.imageCredit}
              />
            )}
          </figure>
        ) : (
          <div class="measure">
            <div class="border-t border-surface" />
          </div>
        )
      }
    </header>
    <div
      class={`measure-wide max-w-300 post-wide prose lg:prose-xl prose-invert prose-headings:heading prose-headings:text-foreground prose-a:text-primary prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-header prose-li:my-0`}
    >
      {/* Site-wide boilerplate, kept in the template rather than in each post so
          it cannot be forgotten on a new one. Subdued on purpose: it is a
          standing notice, not part of the argument. Tailwind Typography selects
          with `:where()`, so these utilities override the prose defaults without
          needing `!important`. */}
      <p class="mt-0 mb-8 text-sm italic text-foreground-subtle">
        Views expressed here are my own and do not necessarily reflect those of my employer.
      </p>
      <slot />
    </div>
    <div class="measure mt-8">
      <PostTags tags={post.tags} />
    </div>
  </article>
</section>
