---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import Section from '~/components/ui/Section.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header
      class={post.image
        ? 'intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade'
        : 'intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade'}
    >
      <Section
        as="div"
        variant="prose"
        spacing={false}
        class="mb-2 flex flex-col justify-between sm:flex-row sm:items-center"
      >
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 text-foreground-subtle" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 text-foreground-subtle" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </Section>

      <Section as="h1" variant="prose" spacing={false} class="heading text-4xl md:text-5xl">
        {post.title}
      </Section>
      <Section as="p" variant="prose" spacing={false} class="mt-4 mb-8 text-xl md:text-2xl text-muted text-justify">
        {post.excerpt}
      </Section>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-225 mx-auto mb-6 sm:rounded-md bg-surface"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post?.excerpt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <Section as="div" variant="prose" spacing={false}>
            <div class="border-t border-surface" />
          </Section>
        )
      }
    </header>
    <Section
      as="div"
      variant="prose"
      spacing={false}
      class="prose lg:prose-xl prose-invert prose-headings:heading prose-headings:text-foreground prose-a:text-primary prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-header prose-li:my-0"
    >
      <slot />
    </Section>
    <Section as="div" variant="prose" spacing={false} class="mt-8">
      <PostTags tags={post.tags} />
    </Section>
  </article>
</section>
